# Copy this file to .env for local testing.
# Never commit the real .env file.

# Full service account key JSON pasted as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gemini API key for poster copy generation.
GEMINI_API_KEY=

# Google Drive folder where generated poster PNGs are saved.
GOOGLE_DRIVE_FOLDER_ID=

# Meta WhatsApp Cloud API permanent or system-user token.
WHATSAPP_TOKEN=

# Meta WhatsApp phone number ID.
WHATSAPP_PHONE_NUMBER_ID=

# Meta webhook verification token.
WHATSAPP_VERIFY_TOKEN=
